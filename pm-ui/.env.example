# Jira API credentials (required for real ticket fetch)
JIRA_USER_EMAIL="your.email@greyorange.com"
JIRA_API_TOKEN="your-atlassian-api-token"
NEXT_PUBLIC_JIRA_BASE_URL="https://greyorange-work.atlassian.net"

# Optional: use hardcoded mock ticket data when Jira creds are missing (offline demo only)
# JIRA_USE_MOCK=true

# Standalone MCP server URL (pm-mcp project)
# pm-ui pre-fetches context over HTTP and passes this URL to spawned Claude Code sessions
MCP_SERVER_URL="http://127.0.0.1:3100/mcp"
