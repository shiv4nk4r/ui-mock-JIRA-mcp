{
  "name": "poc-pm-jira-orchestrator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n mcp,next -c cyan,green \"npm:dev:mcp\" \"next dev\"",
    "dev:mcp": "npx tsx src/mcp-http-server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "start:mcp": "npx tsx src/mcp-http-server.ts",
    "type-check": "tsc --noEmit",
    "crawl:login": "npx playwright install chromium --with-deps && npx tsx src/crawler/auth.ts",
    "crawl": "npx tsx src/crawler/crawl.ts",
    "analyze-captures": "npx tsx src/crawler/analyze-captures.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.161",
    "@anthropic-ai/sdk": "^0.100.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fast-glob": "^3.3.2",
    "firebase": "^12.16.0",
    "graphql": "^16.8.1",
    "next": "^14.2.0",
    "openai": "^6.41.0",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "concurrently": "^9.2.3",
    "node-html-parser": "^7.1.0",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
