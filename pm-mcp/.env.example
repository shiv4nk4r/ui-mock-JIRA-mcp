# MCP server (HTTP transport)
MCP_PORT=3100
MCP_HOST=127.0.0.1

# Git repository (SSH — requires ssh -T git@github.com to succeed)
REPO_URL=git@github.com:greyorange/manager-dashboard.git
REPO_DEFAULT_BRANCH=develop
REPO_AUTO_PULL=true
REPO_CLONE_DIR=.repos/manager-dashboard

# Optional: comma-separated extra directories for filesystem tools
# FS_ALLOWED_DIRS=/path/to/other/dir

# Optional: use an existing local checkout instead of the MCP clone
# REPO_ROOT=/path/to/manager-dashboard
# REPO_USE_LOCAL=true

# ── Rendered Capture Crawler (one-time, dev-only) ─────────────────────────────
# Live, logged-in Manager Dashboard to capture. Required for `npm run crawl`.
# CRAWL_BASE_URL=https://your-manager-dashboard.example.com
# Label/namespace for the capture set (defaults to REPO_DEFAULT_BRANCH).
# CRAWL_LABEL=develop
# Comma-separated seed routes (BFS expands from these). Defaults to "/".
# CRAWL_ROUTES=/,/outbound,/inventory
# How many link-hops to follow from the seeds.
# CRAWL_MAX_DEPTH=1
# Navigate routes client-side via the SPA router. Enable when the static server
# 404s on deep URLs (no history-mode fallback) — boots "/" once, then routes in-app.
# CRAWL_SPA_NAV=true
# Hard cap on pages captured per run.
# CRAWL_MAX_PAGES=40
# Run headless (true) or visible (false). Interactive login is always headed.
# CRAWL_HEADLESS=true
# Optional: automated credential login (skips the interactive headed prompt).
# Leave unset to log in manually via `npm run crawl:login`.
# CRAWL_USERNAME=admin
# CRAWL_PASSWORD=your-password
# Optional: override login form selectors if auto-detection fails.
# CRAWL_USERNAME_SELECTOR=#username
# CRAWL_PASSWORD_SELECTOR=#password
# CRAWL_SUBMIT_SELECTOR=button[type='submit']
# Open + snapshot modals/menus/drawers by clicking safe triggers.
# CRAWL_CAPTURE_MODALS=true
# Slice reusable component subtrees (q-table, q-card, …) into the library.
# CRAWL_CAPTURE_COMPONENTS=true
# Screenshot individual components/modals (slower).
# CRAWL_COMPONENT_SHOTS=false
# Scrub live data values from captured HTML (only needed if sharing captures).
# CRAWL_SANITIZE=false
# Viewport used for capture.
# CRAWL_VIEWPORT_W=1440
# CRAWL_VIEWPORT_H=900
# Optional: record the live app's commit/build id in the manifest.
# CRAWL_APP_COMMIT=
# Build page templates from captured HTML after crawl (default: true).
# CRAWL_ANALYZE_TEMPLATES=true
# Ms to wait after each navigation for data/API to load (default: 400).
# CRAWL_SETTLE_MS=400
# Cap networkidle wait — live dashboards poll forever (default: 2500).
# CRAWL_NETWORK_IDLE_MS=2500
# Ms after modal/menu click; overlay wait capped here (default: 200).
# CRAWL_MODAL_SETTLE_MS=200
# Max ms to wait for q-table rows; 0 = skip (default: 3000).
# CRAWL_TABLE_WAIT_MS=3000
# Max safe UI clicks per page when capturing modals/menus (default: 15).
# CRAWL_MAX_MODAL_CLICKS=15
