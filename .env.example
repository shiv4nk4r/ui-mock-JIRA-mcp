JIRA_USER_EMAIL="email"
JIRA_API_TOKEN="token"

NEXT_PUBLIC_JIRA_BASE_URL="https://greyorange-work.atlassian.net"

# ── Feature flags ─────────────────────────────────────────────────────────────
# All features are OFF by default. Set to "true" only to opt in.
# Do not set these variables at all to keep features disabled.
#
# ENABLE_BUILD_PR=true   ← uncomment only to enable the Build PR button

# ── Firebase (Auth + Firestore + Storage) ─────────────────────────────────────
# Set NEXT_PUBLIC_USE_FIREBASE=true to enable Google SSO and cloud persistence.
# Without this flag the app uses local demo auth + localStorage.
NEXT_PUBLIC_USE_FIREBASE=false

NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Optional: comma-separated emails that get internal (engineering) role on first sign-in.
# All @greyorange.com users default to internal if unset.
# NEXT_PUBLIC_INTERNAL_EMAILS="engineer@greyorange.com,pm@greyorange.com"

# ── Manager Dashboard repo (for MCP code analysis tools + Build PR) ───────────
# Local checkout of greyorange/manager-dashboard. If unset, defaults to
# pm-mcp/.repos/manager-dashboard under this project when that folder exists.
MD_REPO_ROOT="/Users/shivankar.s/gor/poc-mcp/pm-mcp/.repos/manager-dashboard"

# ── GCC Studio Build (Claude Code → GitHub PR) ────────────────────────────────
# Internal "Build" on an approved review: fresh worktree from develop, implement
# via Claude Code CLI, push `{ticketId}-gcc-studio`, open PR against develop.
#
# Requires: `claude`, `git`, and `gh` on the PATH, with push rights to the repo.
#
# GitHub auth for `gh pr create` (prefer a fine-scoped PAT):
# GH_TOKEN=ghp_...
# (GITHUB_TOKEN is also accepted as a fallback)
#
# Isolated worktrees (default: ~/.pm-orchestrator/build-worktrees/{ticketId}):
# BUILD_WORKTREE_ROOT=/path/to/build-worktrees
#
# Job status is persisted under ~/.pm-orchestrator/build-jobs/ so builds continue
# after the browser tab closes. Poll GET /api/build?reviewId=… for live status.
#
# Optional overrides:
# GITHUB_REPO=greyorange/manager-dashboard
# PR_BASE_BRANCH=develop
# BUILD_MODEL=claude-sonnet-4-6

# ── Persistent HTTP MCP server (src/mcp-http-server.ts) ──────────────────────
# The MCP server runs as a separate process alongside Next.js.
# Start both with: npm run dev   (uses concurrently)
# Or separately:   npm run dev:mcp  and  npm run dev:next
#
# Override host/port if 3100 is already taken:
# MCP_PORT=3100
# MCP_HOST=127.0.0.1
#
# Full URL used by the Next.js API route to reach the MCP server:
# MCP_SERVER_URL=http://127.0.0.1:3100/mcp

# ── Rendered Capture Crawler ──────────────────────────────────────────────────
# One-time setup: npm run crawl:login   (saves browser auth state interactively)
# Crawl:          npm run crawl         (BFS-crawls live app, saves captures)
# Analyze:        npm run analyze-captures  (builds reusable page templates)

# Base URL of the live, logged-in Manager Dashboard (required for crawl)
# CRAWL_BASE_URL=https://your-manager-dashboard.example.com

# Label for this capture set — used as the folder name under ~/.pm-orchestrator/captures/
# Defaults to "develop". Set to a branch name to keep multiple sets.
# CRAWL_LABEL=develop

# Comma-separated list of routes to start crawling from (BFS seeds).
# Omit to start from "/" only. Example: /outbound,/inbound,/inventory
# CRAWL_ROUTES=/

# Optional: credentials for automated login (else use `npm run crawl:login` first)
# CRAWL_USERNAME=admin
# CRAWL_PASSWORD=your-password

# Custom CSS selectors for non-standard login forms (omit to use defaults)
# CRAWL_USERNAME_SELECTOR=#username
# CRAWL_PASSWORD_SELECTOR=#password
# CRAWL_SUBMIT_SELECTOR=button[type=submit]

# Custom path to a Playwright storage state JSON (auth cookies/localStorage).
# Defaults to ~/.pm-orchestrator/crawl-auth/<label>.json — only set if you have
# an existing state file from a manual `playwright codegen` run.
# CRAWL_STORAGE_STATE=/path/to/state.json

# Strip auth tokens, UUIDs, and numeric IDs from captured HTML (default: false).
# Enable when sharing captures or committing them to version control.
# CRAWL_SANITIZE=false

# Tag the capture set with the app's current git commit SHA (informational only)
# CRAWL_APP_COMMIT=abc1234

# BFS crawl depth — 0 = seeds only, 1 = seeds + their direct links (default: 1)
# CRAWL_MAX_DEPTH=1

# Hard page cap per run (default: 40)
# CRAWL_MAX_PAGES=40

# Navigate routes client-side via Vue Router instead of full page loads.
# Set true when the server returns 404 on deep URLs (SPA without SSR).
# CRAWL_SPA_NAV=true

# Run template analysis automatically after crawl (default: true)
# CRAWL_ANALYZE_TEMPLATES=true
