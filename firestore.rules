rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isGreyOrange() {
      return isSignedIn()
        && request.auth.token.email.matches('.*@greyorange[.]com$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isGreyOrange();
      allow create, update: if isGreyOrange() && request.auth.uid == userId;
    }

    match /sessions/{sessionId} {
      allow read: if isGreyOrange();
      allow create, update: if isGreyOrange() && request.resource.data.userId == request.auth.uid;
      allow delete: if isGreyOrange() && resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if isGreyOrange();
      allow create: if isGreyOrange() && request.resource.data.userId == request.auth.uid;
      allow update: if isGreyOrange();
    }

    match /shares/{shareId} {
      allow read: if true;
      allow create, update: if isGreyOrange();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isGreyOrange();
    }

    match /engagement/{engagementId} {
      allow read: if isGreyOrange();
      allow create, update: if isGreyOrange() && request.resource.data.userId == request.auth.uid;
    }
  }
}
