  "stateTransitions": [
    {
      "state": "CREATED",
      "allowedTransitions": ["PROCESSING", "CANCELLED"],
      "visibility": "VISIBLE_IN_OPEN_REQUESTS",
      "displayLabel": "Created",
      "userActionAllowed": ["CANCEL_ORDER", "HOLD_ORDER"],
      "duration": "Initial state - waiting for processing"
    },
    {
      "state": "PROCESSING",
      "allowedTransitions": ["PAUSED", "WAITING", "PROCESSED", "FAILED"],
      "visibility": "VISIBLE_IN_ALL",
      "displayLabel": "In Progress",
      "userActionAllowed": ["PAUSE_ORDER", "HOLD_ORDER", "CANCEL_ORDER"],
      "breachDetection": true,
      "breachLogic": "pick_before_time < NOW && status in [PROCESSING, PAUSED, WAITING]"
    },
    {
      "state": "PAUSED",
      "allowedTransitions": ["PROCESSING", "CANCELLED", "FAILED"],
      "visibility": "VISIBLE_IN_ALL",
      "displayLabel": "In Progress",
      "userActionAllowed": ["RESUME_ORDER", "CANCEL_ORDER"],
      "breachDetection": true
    },
    {
      "state": "WAITING",
      "allowedTransitions": ["PROCESSING", "CANCELLED", "FAILED"],
      "visibility": "VISIBLE_IN_ALL",
      "displayLabel": "In Progress",
      "userActionAllowed": ["RESUME_ORDER", "CANCEL_ORDER"],
      "breachDetection": true
    },
    {
      "state": "PROCESSED",
      "allowedTransitions": [],
      "visibility": "VISIBLE_IN_ALL",
      "displayLabel": "Completed",
      "userActionAllowed": [],
      "breachDetection": true,
      "breachLogic": "updatedOn > pick_before_time"
    },
    {
      "state": "FAILED",
      "allowedTransitions": [],
      "visibility": "VISIBLE_IN_ALL",
      "displayLabel": "Failed",
      "userActionAllowed": ["RETRY_ORDER"],
      "breachDetection": true
    },
    {
      "state": "CANCELLED",
      "allowedTransitions": [],
      "visibility": "VISIBLE_IN_ALL",
      "displayLabel": "Cancelled",
      "userActionAllowed": [],
      "breachDetection": false
    }
  ],
  "visibilityRules": {
    "breachedOrders": {
      "description": "Orders where pick_before_time has passed",
      "logic": "((status in [PROCESSING, PAUSED, WAITING, CREATED] AND pick_before_time < NOW) OR (status in [PROCESSED, FAILED, CANCELLED] AND updatedOn > pick_before_time))",
      "displayIndicator": "Red border / badge",
      "filterLabel": "Breached Orders",
      "isBreachedField": "Computed boolean returned with every order"
    },
    "shortPickedOrders": {
      "description": "Orders with exceptions",
      "logic": "exceptions_map[<state>] >= 1",
      "states": ["missing", "damaged", "unscannable", "mismatch"],
      "displayIndicator": "Exception badge with count",
      "visibleInPicker": true
    },
    "multiAreaOrders": {
      "description": "Orders in both GTP and Reserve",
      "logic": "fulfillmentArea.includes('gtp') AND fulfillmentArea.includes('reserve')",
      "displayLabel": "GTP, Reserve",
      "storeModel": "Affects UI display toggle between GTP/Reserve views"
    },
    "conditionalRangerAssist": {
      "description": "Display terminology based on system capability",
      "logic": "isRangerAssistEnabled = true ? show 'Handling Unit' : show 'Carrying Unit'",
      "affectedComponents": [
        "inbound/listing/SubInfo.vue",
        "inbound/modals/OrderPutLineViewDetailsDialog.vue",
        "inbound/listing/OrderViewDetail.vue"
      ]
    }
  },
